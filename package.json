{
  "name": "oh-my-opencode-slim",
  "version": "0.1.0-preview.0",
  "private": true,
  "description": "Unofficial source-only oh-my-opencode-slim replacement fork with integrated OpenCode V1 Goal orchestration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "bin": {
    "oh-my-opencode-slim": "./dist/cli/index.js"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai",
    "agents",
    "orchestration",
    "llm",
    "claude",
    "gpt",
    "gemini"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/userbox020/opencode-goal-orchestration-plugin"
  },
  "bugs": {
    "url": "https://github.com/userbox020/opencode-goal-orchestration-plugin/issues"
  },
  "homepage": "https://github.com/userbox020/opencode-goal-orchestration-plugin#readme",
  "files": [
    "dist",
    "src/companion/companion-manifest.json",
    "src/skills",
    "oh-my-opencode-slim.schema.json",
    "README.md",
    "README.zh-CN.md",
    "README.ja-JP.md",
    "README.ko-KR.md",
    "LICENSE"
  ],
  "scripts": {
    "clean:dist": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build:plugin": "bun build src/index.ts src/tui.ts --outdir dist --target node --format esm --external @ast-grep/napi --external @opencode-ai/plugin --external @opencode-ai/plugin/tui --external @opencode-ai/sdk --external @opencode-ai/sdk/v2 --external @opentui/core --external @opentui/solid --external jsdom --external solid-js --external zod",
    "build:v2": "bun build src/index.ts --outfile dist/server.js --target node --format esm --external @ast-grep/napi --external jsdom",
    "build:cli": "bun build src/cli/index.ts --outdir dist/cli --target node --format esm --external @ast-grep/napi --external @opencode-ai/plugin --external @opencode-ai/plugin/tui --external @opencode-ai/sdk --external @opencode-ai/sdk/v2 --external jsdom --external zod",
    "build": "bun run clean:dist && bun run build:plugin && bun run build:v2 && bun run build:cli && tsc --emitDeclarationOnly && bun run generate-schema",
    "prepare": "bun run build",
    "contributors:add": "all-contributors add",
    "contributors:check": "all-contributors check",
    "contributors:generate": "all-contributors generate",
    "generate-schema": "bun run ./scripts/generate-schema.ts",
    "verify:release": "bun run scripts/verify-release-artifact.ts",
    "verify:host-smoke": "bun run scripts/verify-opencode-host-smoke.ts",
    "verify:goal-workflow": "bun run scripts/verify-opencode-host-smoke.ts --workflow",
    "verify:cache-stability": "bun run scripts/verify-opencode-cache-stability.ts",
    "cache:smoke": "bun run scripts/cache-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "dev": "bun run build && opencode"
  },
  "dependencies": {
    "@ast-grep/cli": "^0.44.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "@opencode-ai/plugin": "1.18.29",
    "@opencode-ai/sdk": "1.18.29",
    "jsdom": "^29.0.0",
    "lru-cache": "^11.5.2",
    "turndown": "^7.2.4"
  },
  "optionalDependencies": {
    "@opentui/solid": "0.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/jsdom": "28",
    "@types/node": "^26.1.1",
    "@types/turndown": "^5.0.6",
    "all-contributors-cli": "^6.26.1",
    "bun-types": "^1.3.14",
    "typescript": "7.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ]
}
